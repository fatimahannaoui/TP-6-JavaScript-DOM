body{
    font-family:Arial;
    text-align:center;
    background-color:#f4f6f8;
}
h1{
    text-align:center ;
    color:#1d3557;
}
form{
    display:flex;
    gap: 10px;
}
input{
    flex:1;
    padding:10px;
    width:250px;
}
button{
    list-style:none;
    padding:8px;
    margin:10px;
    cursor:pointer;
}
ul{
    margin-top:10px;
    background-color:#eef4f8;
    border:1px solide 
}
li{
    list-style:none;
    margin:10px;
    padding:10px;
    border:1px solide gray;
    width:300px;
    margin-left:auto;
    margin-right:auto;
}
.accomplie{
    text-decoration:line-through;
    color:gray;
    background-color:#d8f3dc;
}
